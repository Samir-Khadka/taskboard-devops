# Copy to .env and adjust. docker compose reads .env automatically.
# These are local-development defaults — use real secrets anywhere else.

# PostgreSQL (used by the db service and interpolated into the api's
# DATABASE_URL)
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard

# Grafana admin account (default: admin / admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
