server {
    # PORT / API_SCHEME / API_HOST are substituted by the nginx image's
    # envsubst template step at container start:
    #   docker compose: PORT=80,  API_SCHEME=http,  API_HOST=api:3000
    #   Render:         PORT=<platform port>, API_SCHEME=https,
    #                   API_HOST=<api service hostname>
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static UI
    location / {
        try_files $uri $uri/ =404;
    }

    # API: /api/tasks is proxied as-is to the API service. The Host
    # header and TLS SNI must name the API service itself — Render's
    # edge routes by both; under compose the API ignores them.
    location /api/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Prometheus metrics, exposed through the same origin for convenience.
    location = /metrics {
        proxy_pass ${API_SCHEME}://${API_HOST}/metrics;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header Host ${API_HOST};
    }

    # Liveness of the proxy itself.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
